{
  "name": "antd-form-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @antd-form-generator/example",
    "build": "npm run build --workspace @antd-form-generator/example",
    "preview": "npm run preview --workspace @antd-form-generator/example",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vite-node packages/form-generator/scripts/validateDocument.ts",
    "gen:fixtures": "vite-node packages/form-generator/scripts/genFixtures.ts",
    "gen:schema-doc": "vite-node packages/form-generator/scripts/genSchemaDoc.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
