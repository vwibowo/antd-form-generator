{
  "name": "antd-form-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vite-node -c vitest.config.ts scripts/validateDocument.ts",
    "gen:fixtures": "vite-node -c vitest.config.ts scripts/genFixtures.ts",
    "gen:schema-doc": "vite-node -c vitest.config.ts scripts/genSchemaDoc.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "antd": "^6.5.3",
    "dayjs": "^1.11.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
