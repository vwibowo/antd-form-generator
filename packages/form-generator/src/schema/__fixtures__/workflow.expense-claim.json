{
  "version": 1,
  "kind": "workflow",
  "title": "Expense claim",
  "description": "Every branch below is an ordinary condition — the same editor a form field uses for visibility.",
  "nodes": [
    {
      "id": "wf_start",
      "kind": "start",
      "label": "Claim raised",
      "description": "",
      "name": "",
      "x": 48,
      "y": 240,
      "props": {}
    },
    {
      "id": "wf_details",
      "kind": "form",
      "label": "Claim details",
      "description": "What was spent, and on what.",
      "name": "",
      "x": 336,
      "y": 240,
      "form": {
        "version": 1,
        "title": "Claim details",
        "layout": "vertical",
        "size": "middle",
        "colon": true,
        "gutter": 16,
        "submitText": "Continue",
        "showReset": false,
        "fields": [
          {
            "id": "ec_amount",
            "type": "number",
            "name": "amount",
            "label": "Amount",
            "span": 12,
            "placeholder": "0.00",
            "disabled": false,
            "hidden": false,
            "rules": [
              {
                "kind": "required"
              },
              {
                "kind": "min",
                "value": 1
              }
            ],
            "props": {
              "prefix": "£",
              "precision": 2,
              "min": 0
            }
          },
          {
            "id": "ec_category",
            "type": "select",
            "name": "category",
            "label": "Category",
            "span": 12,
            "placeholder": "Choose a category",
            "disabled": false,
            "hidden": false,
            "rules": [
              {
                "kind": "required"
              }
            ],
            "options": [
              {
                "label": "Travel",
                "value": "travel"
              },
              {
                "label": "Software",
                "value": "software"
              },
              {
                "label": "Equipment",
                "value": "equipment"
              },
              {
                "label": "Client entertainment",
                "value": "entertainment"
              }
            ],
            "props": {}
          },
          {
            "id": "ec_spent_on",
            "type": "date",
            "name": "spentOn",
            "label": "Date of spend",
            "span": 12,
            "placeholder": "Select a date",
            "disabled": false,
            "hidden": false,
            "rules": [
              {
                "kind": "required"
              }
            ],
            "props": {}
          },
          {
            "id": "ec_receipt",
            "type": "upload",
            "name": "receipt",
            "label": "Receipt",
            "span": 12,
            "extra": "Required over £250.",
            "disabled": false,
            "hidden": false,
            "rules": [],
            "props": {}
          },
          {
            "id": "ec_note",
            "type": "textarea",
            "name": "note",
            "label": "What was it for?",
            "span": 24,
            "placeholder": "One line is plenty",
            "disabled": false,
            "hidden": false,
            "rules": [],
            "props": {
              "rows": 3,
              "maxLength": 400,
              "showCount": true
            }
          }
        ]
      },
      "props": {}
    },
    {
      "id": "wf_route",
      "kind": "decision",
      "label": "Route by amount",
      "description": "Small claims pay themselves; large ones need finance.",
      "name": "",
      "x": 624,
      "y": 240,
      "props": {}
    },
    {
      "id": "wf_auto",
      "kind": "action",
      "label": "Auto-approve",
      "description": "Under the threshold — no human in the loop.",
      "name": "",
      "x": 912,
      "y": 48,
      "action": {
        "id": "expense.autoApprove",
        "label": "Auto-approve the claim",
        "params": {}
      },
      "props": {}
    },
    {
      "id": "wf_manager",
      "kind": "approval",
      "label": "Line manager",
      "description": "The everyday path.",
      "name": "managerDecision",
      "x": 912,
      "y": 240,
      "outcomes": [
        {
          "id": "approve",
          "label": "Approve",
          "danger": false
        },
        {
          "id": "reject",
          "label": "Reject",
          "danger": true
        }
      ],
      "props": {}
    },
    {
      "id": "wf_finance_form",
      "kind": "form",
      "label": "Finance questions",
      "description": "Extra detail the finance team always asks for.",
      "name": "",
      "x": 912,
      "y": 432,
      "form": {
        "version": 1,
        "title": "Finance questions",
        "layout": "vertical",
        "size": "middle",
        "colon": true,
        "gutter": 16,
        "submitText": "Send to finance",
        "showReset": false,
        "fields": [
          {
            "id": "ec_budget_code",
            "type": "input",
            "name": "budgetCode",
            "label": "Budget code",
            "span": 12,
            "placeholder": "FI-204",
            "disabled": false,
            "hidden": false,
            "rules": [
              {
                "kind": "required"
              }
            ],
            "props": {}
          },
          {
            "id": "ec_preapproved",
            "type": "radio",
            "name": "preApproved",
            "label": "Was this pre-approved?",
            "span": 12,
            "disabled": false,
            "hidden": false,
            "rules": [
              {
                "kind": "required"
              }
            ],
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "props": {}
          },
          {
            "id": "ec_justification",
            "type": "textarea",
            "name": "justification",
            "label": "Justification",
            "span": 24,
            "placeholder": "Why could this not wait for the next cycle?",
            "disabled": false,
            "hidden": false,
            "rules": [
              {
                "kind": "required"
              },
              {
                "kind": "min",
                "value": 20
              }
            ],
            "props": {
              "rows": 4
            }
          }
        ]
      },
      "props": {}
    },
    {
      "id": "wf_finance",
      "kind": "approval",
      "label": "Finance director",
      "description": "Can send it back for more detail.",
      "name": "financeDecision",
      "x": 1200,
      "y": 432,
      "outcomes": [
        {
          "id": "approve",
          "label": "Approve",
          "danger": false
        },
        {
          "id": "moreInfo",
          "label": "Need more info",
          "danger": false
        },
        {
          "id": "reject",
          "label": "Reject",
          "danger": true
        }
      ],
      "props": {}
    },
    {
      "id": "wf_pay",
      "kind": "action",
      "label": "Pay out",
      "description": "Hand off to payroll.",
      "name": "",
      "x": 1200,
      "y": 240,
      "action": {
        "id": "expense.payOut",
        "label": "Send to payroll",
        "params": {
          "run": "next"
        }
      },
      "props": {}
    },
    {
      "id": "wf_paid",
      "kind": "end",
      "label": "Reimbursed",
      "description": "",
      "name": "",
      "x": 1488,
      "y": 48,
      "props": {}
    },
    {
      "id": "wf_rejected",
      "kind": "end",
      "label": "Rejected",
      "description": "",
      "name": "",
      "x": 1488,
      "y": 432,
      "props": {}
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "from": "wf_start",
      "to": "wf_details",
      "label": "",
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "e_details",
      "from": "wf_details",
      "to": "wf_route",
      "label": "",
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "e_small",
      "from": "wf_route",
      "to": "wf_auto",
      "label": "Under £250",
      "priority": 0,
      "isDefault": false,
      "condition": {
        "logic": "and",
        "conditions": [
          {
            "field": "amount",
            "operator": "lt",
            "value": 250
          }
        ]
      }
    },
    {
      "id": "e_large",
      "from": "wf_route",
      "to": "wf_finance_form",
      "label": "Over £5,000",
      "priority": 1,
      "isDefault": false,
      "condition": {
        "logic": "and",
        "conditions": [
          {
            "field": "amount",
            "operator": "gt",
            "value": 5000
          }
        ]
      }
    },
    {
      "id": "e_normal",
      "from": "wf_route",
      "to": "wf_manager",
      "label": "Everything else",
      "priority": 0,
      "isDefault": true
    },
    {
      "id": "e_auto_paid",
      "from": "wf_auto",
      "to": "wf_paid",
      "label": "",
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "e_mgr_yes",
      "from": "wf_manager",
      "to": "wf_pay",
      "label": "Approved",
      "priority": 0,
      "isDefault": false,
      "condition": {
        "logic": "and",
        "conditions": [
          {
            "field": "managerDecision",
            "operator": "eq",
            "value": "approve"
          }
        ]
      }
    },
    {
      "id": "e_mgr_no",
      "from": "wf_manager",
      "to": "wf_rejected",
      "label": "Otherwise",
      "priority": 0,
      "isDefault": true
    },
    {
      "id": "e_fin_form",
      "from": "wf_finance_form",
      "to": "wf_finance",
      "label": "",
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "e_fin_yes",
      "from": "wf_finance",
      "to": "wf_pay",
      "label": "Approved",
      "priority": 0,
      "isDefault": false,
      "condition": {
        "logic": "and",
        "conditions": [
          {
            "field": "financeDecision",
            "operator": "eq",
            "value": "approve"
          }
        ]
      }
    },
    {
      "id": "e_fin_back",
      "from": "wf_finance",
      "to": "wf_details",
      "label": "Needs more info",
      "priority": 1,
      "isDefault": false,
      "condition": {
        "logic": "and",
        "conditions": [
          {
            "field": "financeDecision",
            "operator": "eq",
            "value": "moreInfo"
          }
        ]
      }
    },
    {
      "id": "e_fin_no",
      "from": "wf_finance",
      "to": "wf_rejected",
      "label": "Otherwise",
      "priority": 0,
      "isDefault": true
    },
    {
      "id": "e_pay_paid",
      "from": "wf_pay",
      "to": "wf_paid",
      "label": "",
      "priority": 0,
      "isDefault": false
    }
  ],
  "edgeStyle": "curve",
  "props": {}
}
